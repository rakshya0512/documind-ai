# Copy to .env and edit. All values are optional.
DATA_DIR=data
MAX_UPLOAD_MB=10
CHUNK_WORDS=180

# --- Login (defaults shown; CHANGE for any public deployment) ---
ADMIN_PASSWORD=12345
VIEWER_PASSWORD=123
# Let a logged-in user switch between Admin and Viewer mode from the header (true/false)
ALLOW_MODE_SWITCH=true
SESSION_HOURS=12
# Secret used to sign login cookies. If empty, one is generated and stored in DATA_DIR/secret.key
SECRET_KEY=

# --- Optional LLM answers (otherwise extractive TF-IDF fallback) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Optional: only if the frontend is hosted on a different domain than the backend
CORS_ORIGINS=
